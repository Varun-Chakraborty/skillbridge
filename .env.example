# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillbridge?schema=public"

# 32+ byte random string used to derive session and IP hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-32-plus-random-bytes"

# Bootstrap only. Comma-separated ATS boards as <ats>:<board token>; these are
# copied into the IngestSource registry the first time sync runs against an
# empty registry, and ignored afterwards. All three ATSes expose public, keyless
# job board endpoints, so this only ever needed the board token that appears in
# the company's careers URL (e.g. greenhouse:figma, ashby:ashby).
#
# To add a company, use `npm run jobs:sources add greenhouse:vercel --token vercel`
# rather than editing this. `npm run jobs:sources` lists every source with its
# row share and retention.
ATS_SOURCES=""

# Total rows one sync may write across all sources, before per-source shares are
# applied. This is a share governor rather than a storage guard — the database
# sits far below its ceiling — and it exists so one large feed cannot dominate
# the table. Sources split it in proportion to their registry weight, and a
# source whose feed is smaller than its slice hands the remainder back, so a
# budget larger than the available supply costs nothing.
SYNC_ROW_BUDGET=6000

# Bearer token for POST /api/jobs/sync so a cron or deploy hook can trigger a
# refresh without a user session. Send `Authorization: Bearer <CRON_SECRET>`.
# When unset, syncing requires a signed-in user instead.
CRON_SECRET=""
