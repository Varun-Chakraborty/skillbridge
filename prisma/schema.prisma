generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  VOLUNTEER
  OTHER
}

enum OpportunityKind {
  INTERNSHIP
  HACKATHON
  WORKSHOP
  JOB

  /// A conference, summit or other multi-session event a student registers to
  /// attend rather than apply to. Added for Unstop's `conferences` feed, which
  /// is the only live event feed found that publishes a registration deadline.
  CONFERENCE
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  headline       String?
  school         String?
  graduationYear Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  skills       Skill[]
  sessions     Session[]
  bookmarks    Bookmark[]
  applications Application[]
  profile      Profile?
  invitations  Invitation[]  @relation("Invitee")
  sentInvites  Invitation[]  @relation("Inviter")

  @@index([email])
}

enum ResumeSource {
  MANUAL
  PARSED
}

/// The student's resume. Every field is a plain column so a future ATS parser
/// can populate the same shape the form writes by hand: the form and the parser
/// both produce a Resume, and nothing downstream needs to know which it was.
///
/// `rawText` keeps the pasted or uploaded text so extraction can be re-run
/// against it later without asking the student to retype anything.
model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  bio          String?
  location     String?
  remoteOnly   Boolean  @default(false)
  hoursPerWeek Int?

  experience String?
  education  String?
  projects   String?
  skillsText String?

  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?

  source   ResumeSource @default(MANUAL)
  parsedAt DateTime?
  rawText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SkillOrigin {
  /// Typed by the student, either in the resume form or the skills editor.
  MANUAL
  /// Read out of resume text by the shared vocabulary in lib/jobs/skills.ts.
  DERIVED
}

model Skill {
  id     String @id @default(cuid())
  userId String
  name   String
  slug   String
  level  Int    @default(3)

  origin SkillOrigin @default(MANUAL)

  definitionId String

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  definition SkillDefinition @relation(fields: [definitionId], references: [id])

  @@unique([userId, slug])
  @@index([slug])
  @@index([definitionId])
  @@index([userId, origin])
}

model SkillDefinition {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  aliases   String[] @default([])
  createdAt DateTime @default(now())

  opportunities OpportunitySkill[]
  users         Skill[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipHash     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Opportunity {
  id         String          @id @default(cuid())
  source     String
  externalId String
  kind       OpportunityKind @default(JOB)

  title          String
  company        String?
  location       String?
  remote         Boolean        @default(false)
  employmentType EmploymentType @default(OTHER)
  salaryMin      Int?
  salaryMax      Int?
  currency       String?
  description    String?
  applyUrl       String?
  logoUrl        String?

  /// Tags exactly as the source published them. Persisted as a column rather
  /// than left inside the upstream payload because skill extraction folds tags
  /// into the result, and re-deriving links later needs them without re-parsing
  /// six different payload shapes.
  tags String[] @default([])

  /// Which version of the skill vocabulary produced this row's links. Sync
  /// stamps the current version on every write, so a stale value means the row
  /// aged out of its feed before a vocabulary change and was never re-derived.
  vocabVersion Int @default(0)

  publishedAt DateTime?

  /// The last moment a student can *act* on this row — the deadline to submit a
  /// job application, to register for a conference, or to hand in a hackathon
  /// submission. One column across all kinds because the meaning is the same in
  /// each: the point after which acting is pointless.
  ///
  /// This was previously dead. Greenhouse populates it from
  /// `application_deadline`, but no other feed published a closing date, so it
  /// was always null and documented as a known gap. The event feeds fill it —
  /// Unstop from `regnRequirements.end_regn_dt`, Devpost from the end of its
  /// submission window — which is what makes "closes in 6 days" renderable.
  expiresAt DateTime?

  /// When an event begins. For HACKATHON and CONFERENCE this is when the event
  /// or submission window opens; null for jobs, which have no start date. Kept
  /// distinct from `publishedAt`, which is when the posting was announced.
  startsAt DateTime?

  /// When an event finishes. For CONFERENCE this is the last day; for HACKATHON
  /// it is when submissions and judging close. Null for jobs.
  endsAt DateTime?

  fetchedAt DateTime  @default(now())

  /// When this row becomes eligible for deletion, materialized by sync from the
  /// owning source's `ttlDays` at write time rather than resolved through a join
  /// at sweep time. Two reasons: the sweeper becomes a single indexed range scan
  /// instead of a join across every source, and a row carries the policy it was
  /// written under, so changing a source's TTL does not retroactively apply to
  /// rows that have not been re-fetched since.
  ///
  /// Upstream does publish real closing dates for events, but they are kept in
  /// `expiresAt`/`endsAt` rather than here: `ttlExpiresAt` is a retention
  /// policy, not a fact about the posting, and a row that ages out of its feed
  /// has no closing date at all.
  ttlExpiresAt DateTime?

  bookmarks    Bookmark[]
  applications Application[]
  matches      OpportunitySkill[]

  @@unique([source, externalId])
  @@index([kind])
  @@index([publishedAt])
  @@index([vocabVersion])
  @@index([ttlExpiresAt])
  @@index([startsAt])
  @@index([endsAt])
}

enum IngestSourceKind {
  /// A single company's public ATS board, addressed by its board token.
  ATS
  /// A multi-company aggregator feed.
  AGGREGATOR
}

/// The ingestion registry. Every source sync reads from this table, including
/// which ATS board tokens exist, so adding a company no longer means editing a
/// comma-separated secret in two places (GitHub Actions and Vercel).
///
/// Deliberately distinct from `Opportunity.source`, which is a free-form string
/// tag like `greenhouse:stripe` kept on the row for cheap grouping. This table
/// is the policy: share, retention and selection rules per source.
model IngestSource {
  id String @id @default(cuid())

  /// Matches `Opportunity.source` for this source, e.g. `arbeitnow`,
  /// `greenhouse:stripe`. Unique, and the join key between the two.
  key   String           @unique
  kind  IngestSourceKind
  label String?

  /// Board token for ATS sources (`greenhouse:stripe` -> `stripe`). Public: it
  /// appears in the company's own job board URL, so it is configuration rather
  /// than a secret.
  boardToken String?

  enabled Boolean @default(true)

  /// Relative share of the per-sync row budget. Every enabled source starts
  /// equal at 100, so a six-source registry ingests six roughly equal slices.
  /// Raising one source's weight and lowering another's shifts capacity toward
  /// the one that is performing; weight is a ratio, not a percentage.
  weight Int @default(100)

  /// Hard retention in days, materialized onto each row as `ttlExpiresAt`.
  ttlDays Int @default(30)

  /// When set, only entry-level postings from this source are ingested and the
  /// rest are dropped. Per-source rather than global because the aggregators
  /// are dominated by senior roles that a student hub has no use for, while the
  /// ATS boards are not.
  entryLevelOnly Boolean @default(false)

  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled])
}

model OpportunitySkill {
  opportunityId String
  skillSlug     String

  opportunity Opportunity     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill       SkillDefinition @relation(fields: [skillSlug], references: [slug], onDelete: Cascade)

  @@id([opportunityId, skillSlug])
  @@index([skillSlug])
}

model Bookmark {
  id            String   @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId])
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(APPLIED)
  notes         String?
  appliedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
  @@index([userId, status])
}

model Invitation {
  id        String   @id @default(cuid())
  inviterId String
  inviteeId String
  message   String?
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  inviter User @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeId])
  @@index([inviteeId, accepted])
}
